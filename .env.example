# ============================================================
#  MaxBridge — пример конфигурации. Скопируй в .env и заполни.
#  .env в .gitignore — реальные ключи НИКОГДА не попадают в git.
# ============================================================

# ---------- Telegram ----------
# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456:AA...

# Твой Telegram user id (узнать: @userinfobot). Только он управляет мостом.
TELEGRAM_OWNER_ID=0

# Прокси для Telegram. Нужен там, где провайдер режет api.telegram.org
# (частый случай на российских хостингах — таймаут на api.telegram.org).
# MAX при этом ходит НАПРЯМУЮ, его сессия остаётся местной.
# Пример: http://IP-западного-сервера:8888
TELEGRAM_PROXY=

# ID супергруппы с включёнными ТЕМАМИ (форум). Каждый чат MAX = отдельная тема.
# Создай группу -> Настройки -> Темы (Topics) ON -> добавь бота админом ->
# затем выполни /bind в этой группе, бот сам подставит id сюда в лог.
# Оставь ПУСТЫМ — заполнится сам командой /bind в нужной группе.
TELEGRAM_FORUM_CHAT_ID=

# ---------- MAX ----------
# Режим транспорта: userbot | botapi
#   userbot — читает ВСЕ сообщения (личные, группы, каналы), отвечает от твоего
#             имени. Использует внутренний WebSocket-API MAX. См. docs/LEGAL.md.
#   botapi  — официальный Bot API. Легально и стабильно, НО бот видит только
#             сообщения, адресованные ему (упоминания/команды/личка боту).
MAX_MODE=userbot

# --- для MAX_MODE=userbot ---
# Телефон аккаунта MAX в международном формате. Логин делается один раз
# командой `python -m maxbridge login`, сессия ложится в ./data/max_session.json
MAX_PHONE=+79990000000

# --- для MAX_MODE=botapi ---
MAX_BOT_TOKEN=
MAX_API_BASE=https://platform-api.max.ru

# ---------- AI (killer-фичи: сводки, приоритеты, черновики, перевод) ----------
# Пусто -> AI-функции выключены, мост работает как обычный релей.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5
AI_ENABLED=true
# Язык итоговых сводок и черновиков
AI_LANG=ru

# Прокси ТОЛЬКО для Anthropic. Нужен, если сервер стоит в стране, откуда
# Anthropic не обслуживает: запросы к api.anthropic.com отбиваются с 403.
# MAX и Telegram через прокси не идут — сессия MAX должна приходить
# с локального адреса сервера, иначе это выглядит как вход из другой страны.
# Пример: http://user:pass@зарубежный-сервер:3128
AI_PROXY=
# Свой релей вместо api.anthropic.com (если поднимаешь прокси-эндпоинт)
AI_BASE_URL=

# ---------- Поведение ----------
# Не помечать сообщения в MAX прочитанными (режим «невидимка»)
STEALTH_MODE=true
# Час ежедневного дайджеста (0-23, по времени сервера). -1 = выключить.
DIGEST_HOUR=9
# Через сколько минут без ответа напоминать о заданном вопросе (0 = выкл)
FOLLOWUP_MINUTES=180
# Путь к БД
DB_PATH=data/maxbridge.db
LOG_LEVEL=INFO

# ---------- Лицензия (для коммерческого распространения) ----------
# Пусто = community-режим (1 аккаунт MAX, базовые функции).
MAXBRIDGE_LICENSE_KEY=

# ============================================================
#  ПЛАТНЫЙ КОНТУР (лицензия Pro): эскалация в SMS и WhatsApp
#  Логика: срочное сообщение висит без ответа N минут ->
#  летит короткое уведомление в указанные каналы.
# ============================================================

# Через сколько минут без ответа эскалировать. 0 = выключено.
ESCALATE_AFTER_MINUTES=0
# Куда эскалировать: sms, whatsapp (через запятую)
ESCALATE_CHANNELS=

# ---------- SMS ----------
# Провайдер: smsru | smsc | twilio
SMS_PROVIDER=
# smsru: api_id | twilio: Auth Token
SMS_API_KEY=
# smsc: логин | twilio: Account SID
SMS_LOGIN=
# smsc: пароль
SMS_PASSWORD=
# Имя отправителя (если согласовано у провайдера) / номер Twilio
SMS_FROM=
# Твой номер, куда слать уведомления
SMS_TO=

# ---------- WhatsApp ----------
# Провайдер: cloud | waha
#   cloud — официальный WhatsApp Business Cloud API (Meta). Легально и платно.
#           Вне 24-часового окна Meta пропускает ТОЛЬКО одобренный шаблон.
#   waha  — self-hosted мост к WhatsApp Web. Без верификации и шаблонов,
#           но неофициальный: аккаунт могут заблокировать.
WHATSAPP_PROVIDER=
# cloud: постоянный токен доступа | waha: X-Api-Key (если включён)
WHATSAPP_TOKEN=
# cloud: Phone Number ID из Meta for Developers
WHATSAPP_PHONE_ID=
# Твой номер в международном формате, только цифры
WHATSAPP_TO=
# cloud: имя одобренного шаблона с одним параметром {{1}}. Пусто = обычный текст
# (сработает только внутри 24-часового окна).
WHATSAPP_TEMPLATE=
# waha: адрес твоего инстанса и имя сессии
WAHA_URL=
WAHA_SESSION=default

# ---------- Ответы ИЗ WhatsApp обратно в MAX (Pro) ----------
# Поднимает локальный вебхук. Формат ответа в WhatsApp:
#   «текст»          -> уйдёт в чат последней эскалации
#   «#42 текст»      -> уйдёт в конкретный чат MAX
# Для Cloud API адрес нужно опубликовать наружу по HTTPS (nginx),
# для WAHA достаточно локального адреса.
WA_WEBHOOK_ENABLED=false
WA_WEBHOOK_HOST=127.0.0.1
WA_WEBHOOK_PORT=8081
# Придумай строку и укажи её же в настройках вебхука Meta
WA_VERIFY_TOKEN=

# ---------- Голосовые в текст ----------
# Любой сервис, совместимый с OpenAI /v1/audio/transcriptions
# (Whisper API, локальный faster-whisper, ASR-шлюз). Пусто = выключено.
ASR_URL=
ASR_KEY=
ASR_MODEL=whisper-1
ASR_LANG=ru
